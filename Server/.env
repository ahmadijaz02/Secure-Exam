MONGODB_URI=mongodb+srv://mahmadijaz192:ahmad3643@cluster0a.e4g2z.mongodb.net/exam_monitoring?retryWrites=true&w=majority
MONGODB_DB_NAME=exam_monitoring
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
JWT_SECRET_KEY=dev-jwt-secret-change-in-production

# ── Camera / RTSP ──────────────────────────────────────────────────────────
# Main stream (Channel 101) = 6MP / 1080p full quality → best for detection
MONITOR_CAMERA_SOURCE=rtsp://admin:asdf%400786@192.168.100.3:554/Streaming/Channels/101
# Always use TCP for Hikvision — avoids UDP packet loss that causes freezing
MONITOR_RTSP_TRANSPORT=tcp
MONITOR_CAMERA_FPS=15

# ── RTSP tuning ────────────────────────────────────────────────────────────
# How long (ms) to wait for the stream to open before warning and continuing
RTSP_OPEN_TIMEOUT_MS=10000
# Socket-level read timeout (ms) — if no data in this window → reconnect
RTSP_READ_TIMEOUT_MS=8000
# Seconds to wait before retrying a dropped connection
RTSP_RECONNECT_DELAY_SEC=3.0
# 0 = reconnect forever (recommended for FYP live demo)
RTSP_MAX_RECONNECTS=0

# ── Stream output to browser ───────────────────────────────────────────────
# 1280×720 matches the internal processing resolution — no lossy downscale,
# sharp enough to read faces and detect small objects (phones, watches)
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_JPEG_QUALITY=95
STREAM_JPEG_OPTIMIZE=0
STREAM_TARGET_FPS=15

# ── Processing ─────────────────────────────────────────────────────────────
# Keep at 1 — we resize inside monitor.py, not at the capture layer
FORCE_PROCESS_RESIZE=1
# Processing resolution (fed to YOLO and MediaPipe)
MONITOR_FRAME_WIDTH=1920
MONITOR_FRAME_HEIGHT=1080
# YOLO runs on every 2nd frame; MediaPipe every 4th — keeps CPU/GPU headroom
YOLO_PROCESS_EVERY=2
MEDIAPIPE_PROCESS_EVERY=4
# YOLO inference image size — 960 gives best accuracy/speed balance
YOLO_IMAGE_SIZE=1280

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
